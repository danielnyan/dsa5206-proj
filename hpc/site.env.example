# Use absolute paths without commas (PBS -v separator).
REPO_DIR=/scratch/USER/dsa5206-proj
DATA_ROOT=/scratch/USER/dsa5206-data
PREPARED_DIR=/scratch/USER/dsa5206-data/derived/gleason-v1
RUN_ROOT=/scratch/USER/dsa5206-runs
VENV_DIR=/scratch/USER/envs/dsa5206
# Optional trusted site commands; set to your cluster's Python/CUDA modules.
SITE_SETUP=''
PREP_WORKERS=8
DATA_VARIANT=raw-crowd
# Download route includes normalized SICAPv2. Accepting it records a preprocessing
# deviation because we still apply the established Tolkach reference afterwards.
ALLOW_PRENORMALIZED=1
BATCH_SIZE=100
SMOKE_BATCH_SIZE=1
SEED=42
# Alternative original SICAP roots (all four roots must be set together):
# CROWD_IMAGES=/scratch/USER/raw/crowd
# CROWD_ANNOTATIONS=/scratch/USER/raw/crowd-annotations
# SICAP_IMAGES=/scratch/USER/raw/SICAPv2/images
# SICAP_ANNOTATIONS=/scratch/USER/raw/SICAPv2
