# COPY this file to /scratch/USER/site.env OUTSIDE the repository and edit it.
# Pass it to PBS with: qsub -v PIPELINE_CONFIG=/scratch/USER/site.env ...
# Use absolute paths without commas (PBS -v separates fields with commas).
REPO_DIR=/scratch/USER/dsa5206-proj
WORK_ROOT=/scratch/USER/dsa5206-work

# Optional site-specific Python/CUDA module commands; adapt to your Vanda modules.
SITE_SETUP='source /app1/ebenv; module load Python/3.13.1-GCCcore-14.2.0'

# Existing Gleason/PANDA configuration (preserved from the gleason template).
SICAP_WSI_LABELS=/scratch/USER/raw/SICAPv2/wsi_labels.xlsx
PANDA_CHUNKS_DIR=/scratch/USER/raw/panda_chunks
PANDA_ALLOW_PARTIAL=0
DATASET=${DATASET:-crowd-sicap}
DATA_ROOT=${DATA_ROOT:-$WORK_ROOT/data}
VENV_DIR=${VENV_DIR:-$WORK_ROOT/env}
PREPARED_DIR=${PREPARED_DIR:-$WORK_ROOT/prepared/$DATASET-v2}
RUN_ROOT=${RUN_ROOT:-$WORK_ROOT/runs/$DATASET}
EPOCH14_MODEL=/scratch/USER/checkpoints/epoch14.keras
PROBE_BATCH_SIZE=1
PROBE_SEED=42
PROBE_REPEATS=20
PROBE_NN_DEVICE=gpu

# D8 ESCNN settings; edit these paths before submission.
# The Stage-2G cache must already contain cache.json, verification.json,
# context.json, and its complete train/internal_validation .npy shards.
ESCNN_STAGE2G_CACHE=/scratch/USER/path/to/verified/Stage2G/cache
ESCNN_OUTPUT=/scratch/USER/dsa5206-work/runs/escnn-d8-stage2g-v1
# If the Gleason VENV_DIR does not contain torch + escnn, set a separate env:
# ESCNN_VENV_DIR=/scratch/USER/dsa5206-work/escnn-env

# For separate VAL2 evaluation (not used in training):
# ESCNN_VAL2_EXTRACTED=/scratch/USER/data/extracted-val2

# Optional settings from the original Gleason template:
# PREP_WORKERS=8
# BATCH_SIZE=4
# SMOKE_BATCH_SIZE=1
# TRAINING_COHORT=published
# PREPARED_DIR=/scratch/USER/fresh-preparation-path
# CROWD_IMAGES=/scratch/USER/raw/crowd
# CROWD_ANNOTATIONS=/scratch/USER/raw/crowd-annotations
# SICAP_IMAGES=/scratch/USER/raw/SICAPv2/images
# SICAP_ANNOTATIONS=/scratch/USER/raw/SICAPv2
