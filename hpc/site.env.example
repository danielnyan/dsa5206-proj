# Copy to site.env OUTSIDE the repo, then edit these two paths.
# Use absolute paths without commas (PBS -v uses commas as separators).
REPO_DIR=/scratch/USER/dsa5206-proj
WORK_ROOT=/scratch/USER/dsa5206-work

# Optional site-specific Python/CUDA module commands.
SITE_SETUP='source /app1/ebenv; module load Python/3.13.1-GCCcore-14.2.0'

# Required only for the pure Crowd/SICAP track. Stage this small original file.
SICAP_WSI_LABELS=/scratch/USER/raw/SICAPv2/wsi_labels.xlsx

# PANDA transfer-shard track. Upload each Kaggle shard ZIP + its SHA sidecar
# directly into this directory; do NOT combine the ZIPs yourself.
PANDA_CHUNKS_DIR=/scratch/USER/raw/panda_chunks

# Set to 1 only for deliberate preliminary training from an incomplete chunk
# prefix (for example just chunk 0000). The preparation/model metadata will be
# marked sample_only/preliminary. Set back to 0 for the final full-cohort run.
PANDA_ALLOW_PARTIAL=0

# Derived paths: the submit helper selects DATASET, not manual config edits.
DATASET=${DATASET:-crowd-sicap}
DATA_ROOT=${DATA_ROOT:-$WORK_ROOT/data}
VENV_DIR=${VENV_DIR:-$WORK_ROOT/env}
PREPARED_DIR=${PREPARED_DIR:-$WORK_ROOT/prepared/$DATASET-v2}
RUN_ROOT=${RUN_ROOT:-$WORK_ROOT/runs/$DATASET}

# Optional overrides only when needed:
# PREP_WORKERS=8
# BATCH_SIZE=4             # recommended starting point for PANDA/NASNetLarge
# SMOKE_BATCH_SIZE=1
# TRAINING_COHORT=published  # baseline only; cannot be a mining teacher
# PREPARED_DIR=/scratch/USER/fresh-preparation-path
# Original SICAP route: provide all four paths together.
# CROWD_IMAGES=/scratch/USER/raw/crowd
# CROWD_ANNOTATIONS=/scratch/USER/raw/crowd-annotations
# SICAP_IMAGES=/scratch/USER/raw/SICAPv2/images
# SICAP_ANNOTATIONS=/scratch/USER/raw/SICAPv2
