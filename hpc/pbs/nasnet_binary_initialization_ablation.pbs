#!/usr/bin/env bash
#PBS -N nasnet-init-ablation
#PBS -l select=1:ncpus=8:ngpus=1:mem=96gb
#PBS -l walltime=48:00:00
#PBS -j oe
set -euo pipefail
: "${PIPELINE_CONFIG:?qsub -v PIPELINE_CONFIG=/absolute/path/to/site.env}"
source "$PIPELINE_CONFIG"
if [[ -n "${SITE_SETUP:-}" ]]; then eval "$SITE_SETUP"; fi
source "$VENV_DIR/bin/activate"
cd "$REPO_DIR"
export PYTHONPATH="$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}"
export TF_CPP_MIN_LOG_LEVEL=2
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export TF_DETERMINISTIC_OPS=1
# Vanda allocates exactly one GPU to this job; its ID is scheduler-assigned.
nvidia-smi -L
mode=${SCRATCH_MODE:-train}
case "$mode" in
  train)
    : "${VAL1_CACHE:?Set VAL1_CACHE to the VERIFIED Stage 2G cache directory}"
    output=${SCRATCH_OUTPUT:-"$RUN_ROOT/nasnet-binary-init-${SCRATCH_INIT:-scratch}"}
    args=(train --cache "$VAL1_CACHE" --output "$output" \
      --initialization "${SCRATCH_INIT:-scratch}" \
      --learning-rate "${SCRATCH_LR:-0.0001}" \
      --batch-size "${SCRATCH_BATCH:-4}" \
      --effective-batch "${SCRATCH_EFFECTIVE_BATCH:-100}" \
      --validation-batch "${SCRATCH_VAL_BATCH:-16}" \
      --seed "${SCRATCH_SEED:-42}" \
      --max-epochs "${SCRATCH_MAX_EPOCHS:-14}")
    ;;
  test)
    : "${SCRATCH_OUTPUT:?Set SCRATCH_OUTPUT to the finished 14-epoch model directory}"
    : "${VAL2_EXTRACTED:?Set VAL2_EXTRACTED to the original extracted VAL2 directory}"
    test_output=${SCRATCH_TEST_OUTPUT:-"${SCRATCH_OUTPUT}/final_VAL2_evaluation"}
    args=(test --model-dir "$SCRATCH_OUTPUT" --extracted "$VAL2_EXTRACTED" \
      --output "$test_output" --final-test --batch-size "${SCRATCH_TEST_BATCH:-4}")
    ;;
  *) echo "SCRATCH_MODE must be train or test" >&2; exit 2;;
esac
python -u -m hpc.nasnet_binary_initialization_ablation "${args[@]}"
