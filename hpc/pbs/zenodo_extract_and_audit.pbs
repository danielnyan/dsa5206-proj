#!/usr/bin/env bash
#PBS -N zenodo-extract
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=12:00:00
#PBS -j oe
set -euo pipefail
: "${ZROOT:?Supply ZROOT via qsub -v}"
archives="$ZROOT/archives"
extracted="$ZROOT/extracted"
mkdir -p "$extracted"
cd "$archives"
cat > expected.md5 <<'SUMS'
1dda32f59996640d701b591f69353115  val_dataset_1_norm.zip
35494acbfea3adbc689cc15f73a9116d  val_dataset_1_tu.zip
029069ab405a76d42fcdefac32982989  val_dataset_2_norm.zip
d72b78d364fbfed95d8f0d71d8f2d01e  val_dataset_2_tu.zip
SUMS
md5sum -c expected.md5
for name in val_dataset_1_norm val_dataset_1_tu val_dataset_2_norm val_dataset_2_tu; do
  mkdir -p "$extracted/$name"
  echo "Extracting $name; existing files preserved (-n)"
  unzip -q -n "$archives/$name.zip" -d "$extracted/$name"
done
expected=(93009 52810 24471 9632)
names=(val_dataset_1_norm val_dataset_1_tu val_dataset_2_norm val_dataset_2_tu)
for i in 0 1 2 3; do
  name="${names[$i]}"
  observed=$(find "$extracted/$name" -type f -name '*.jpg' | wc -l)
  echo "$name: $observed JPEGs (expected ${expected[$i]})"
  [[ "$observed" -eq "${expected[$i]}" ]] || { echo "COUNT MISMATCH: $name" >&2; exit 1; }
done
[[ -f "$extracted/val_dataset_1_norm/norm/norm.0.jpg" ]] || { echo "Unexpected normal ZIP layout" >&2; exit 1; }
[[ -f "$extracted/val_dataset_1_tu/tu/tu.0.jpg" ]] || { echo "Unexpected tumour ZIP layout" >&2; exit 1; }
echo 'EXTRACTION AND ARCHIVE AUDIT COMPLETE'
