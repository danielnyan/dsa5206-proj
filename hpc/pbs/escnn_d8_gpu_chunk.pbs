#!/usr/bin/env bash
#PBS -N escnn-d8-chunk
#PBS -l select=1:ncpus=8:ngpus=1:mem=96gb
#PBS -l walltime=48:00:00
#PBS -j oe
# Add #PBS -P personal-... if your cluster requires it.
set -euo pipefail

source "${PIPELINE_CONFIG:?Pass absolute PIPELINE_CONFIG using qsub -v}"
if [[ -n "${ESCNN_SITE_SETUP:-}" ]]; then
  eval "$ESCNN_SITE_SETUP"
elif [[ -n "${SITE_SETUP:-}" ]]; then
  eval "$SITE_SETUP"
fi

cd "${REPO_DIR:?Set REPO_DIR in site.env}"
: "${WORK_ROOT:?Set WORK_ROOT in site.env}"
: "${ESCNN_OUTPUT:?Set ESCNN_OUTPUT in site.env}"
: "${ESCNN_STAGE2G_CACHE:?Set ESCNN_STAGE2G_CACHE in site.env}"
ESCNN_VENV_DIR="${ESCNN_VENV_DIR:-$WORK_ROOT/escnn-env}"
[[ -f "$ESCNN_VENV_DIR/.escnn-ready" ]] || {
  echo 'CPU environment setup did not finish; refusing GPU training' >&2; exit 2;
}
source "$ESCNN_VENV_DIR/bin/activate"
export PYTHONPATH="$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=4
export ESCNN_STAGE2G_CACHE

[[ -f "$ESCNN_STAGE2G_CACHE/cache.json" ]] || { echo 'Missing cache.json' >&2; exit 2; }
[[ -f "$ESCNN_STAGE2G_CACHE/verification.json" ]] || { echo 'Missing verification.json' >&2; exit 2; }
command -v timeout >/dev/null || { echo 'GNU timeout required' >&2; exit 2; }

# The submitter serializes jobs. Do not manually run two writers concurrently.
# A completed job in the chain exits immediately without consuming GPU cycles.
mkdir -p "$ESCNN_OUTPUT"
TARGET="${ESCNN_EPOCHS:-20}"
DONE=$(python - "$ESCNN_OUTPUT/last.pt" "$TARGET" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); max_epochs=int(sys.argv[2])
if not p.is_file():
    print(0)
else:
    import torch
    state=torch.load(p,map_location='cpu',weights_only=False)['progress']
    complete=(state['epoch']>=max_epochs or
              state['epochs_without_improvement']>=4)
    if complete and not p.with_name('best.pt').is_file():
        raise SystemExit('Training ended but best.pt is missing')
    print(1 if complete else 0)
PY
)
if [[ "$DONE" == 1 ]]; then
  echo 'ESCNN run already finished (early stop or epoch target). Nothing to do.'
  exit 0
fi

# Only the very first chunk runs the preflight. The CPU cache structure check
# is read-only; the D8 forward/backward exercise uses exactly batch=4.
if [[ ! -f "$ESCNN_OUTPUT/last.pt" ]]; then
  python - <<'PY'
import os, torch, escnn
from modern_pca import reimplementation as r
from modern_pca.escnn_stage2g import load_stage2g_datasets
from modern_pca.group_equivariant_model import D8MultiScaleResNetGAP
assert torch.cuda.is_available(), 'No CUDA device'
print('GPU:',torch.cuda.get_device_name(0),'Torch:',torch.__version__,
      'torch CUDA:',torch.version.cuda,'ESCNN:',escnn.__version__,flush=True)
rows=r.read_manifest('manifests/VAL1_manifest.csv')
train, val=r.split_val1(rows)
a,b,catalog=load_stage2g_datasets(os.environ['ESCNN_STAGE2G_CACHE'],train,val)
assert len(a)==116655 and len(b)==29164
x,label=a[0]
assert x.dtype==torch.uint8 and x.shape==(3,350,350) and label in (0,1)
print('Cache mapping PASS:',catalog,flush=True)
model=D8MultiScaleResNetGAP().cuda().train()
assert model.gspace.fibergroup.order()==16
assert [model.f88_type.size,model.f44_type.size,model.f22_type.size,
        model.f11_type.size]==[128,256,384,512]
x=torch.randn(4,3,350,350,device='cuda')
loss=model(x).square().mean()
loss.backward()
torch.cuda.synchronize()
print('D8 batch-4 forward/backward PASS; allocated GiB:',
      round(torch.cuda.max_memory_allocated()/1024**3,2),flush=True)
PY
fi

extra=()
if [[ -f "$ESCNN_OUTPUT/last.pt" ]]; then
  extra+=(--resume "$ESCNN_OUTPUT/last.pt")
fi

# Stop ahead of PBS's 48-hour hard limit. GNU timeout returns 124 on expiry.
# The trainer saves atomically at epoch boundaries and periodically during epochs.
set +e
timeout --signal=INT --kill-after=180s "${ESCNN_CHUNK_HOURS:-42}h" \
  python -u -m modern_pca.train_group_equivariant \
    --cache "$ESCNN_STAGE2G_CACHE" \
    --output "$ESCNN_OUTPUT" \
    --epochs "$TARGET" \
    --device cuda \
    --batch-size 4 \
    --num-workers 4 \
    --patience 4 \
    --min-delta 0 \
    --checkpoint-every 1000 \
    "${extra[@]}"
rc=$?
set -e

if [[ "$rc" == 124 ]]; then
  [[ -f "$ESCNN_OUTPUT/last.pt" ]] || {
    echo 'Timed out without any resumable checkpoint' >&2; exit 1;
  }
  echo 'Planned time limit reached. Checkpoint retained; next dependent PBS job resumes.'
  exit 0
fi
if [[ "$rc" != 0 ]]; then
  echo "Training FAILED with exit code $rc; halting the afterok chain." >&2
  exit "$rc"
fi

# Trainer returned normally: must have reached the target or early stopping.
python - "$ESCNN_OUTPUT/last.pt" "$TARGET" <<'PY'
import sys,torch
state=torch.load(sys.argv[1],map_location='cpu',weights_only=False)['progress']
if not (state['epoch']>=int(sys.argv[2]) or state['epochs_without_improvement']>=4):
    raise SystemExit('Trainer exited cleanly without reaching stop criterion')
print('TRAINING COMPLETE:',state['epoch'],'epochs; best epoch',state['best_epoch'],
      '; best validation loss',state['best_val_loss'],flush=True)
PY
