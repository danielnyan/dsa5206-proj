#!/usr/bin/env bash
#PBS -N gleason-eval
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
source "${PIPELINE_CONFIG:?Supply absolute site.env path}"
: "${MODEL_DIR:?Supply frozen model directory}"
if [[ -n "${SITE_SETUP:-}" ]]; then eval "$SITE_SETUP"; fi
source "$VENV_DIR/bin/activate"
cd "$REPO_DIR"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
case "${MODE:-production}" in
  production) extra=(--final-evaluation); suffix=evaluation;;
  smoke) extra=(--smoke); suffix=validation;;
  mine) extra=(--mine); suffix=mining;;
  *) echo 'MODE must be production, smoke or mine' >&2; exit 2;;
esac
python -u -m modern_pca.evaluate_gleason --model-dir "$MODEL_DIR" \
  --manifests "$PREPARED_DIR/manifests" --cache "$PREPARED_DIR/cache" \
  --output "$RUN_ROOT/${PBS_JOBID}-${suffix}" "${extra[@]}"
